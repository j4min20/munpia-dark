{
  "manifest_version": 3,
  "name": "문피아 다크",
  "version": "1",
  "description": "문피아 다크 모드 확장 프로그램.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "문피아 다크 설정",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.munpia.com/*"
      ],
      "css": [
        "styles/theme.css",
        "styles/viewer.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
